{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "version:generate": "node -e \"fs=require('fs');try{v=require('child_process').execSync('git rev-parse --short HEAD').toString().trim()}catch{v=process.env.GITHUB_SHA?process.env.GITHUB_SHA.slice(0,7):'unknown'};fs.writeFileSync('version.json',JSON.stringify({version:v}))\"",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13",
    "firebase-functions": "^7",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-plugin-promise": "^7"
  },
  "private": true
}
